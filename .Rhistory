group_by(dem_ex_1) %>%
mutate(ctd1 = n()) %>%
group_by(dem_ex_2) %>%
mutate(ctd2 = n()) %>%
group_by(dem_ex_3) %>%
mutate(ctd3 = n()) %>%
mutate(
dem_ex_1 = tolower(dem_ex_1),
demX1 = case_when(
(!is.na(dem_ex_11) & dem_ex_11 %in% c("obama", "oboma")) ~ "barack obama",
(!is.na(dem_ex_1) & dem_ex_1 %in% c("hillary clinton", "hilary clinton", "clinton")) ~ "hillary clinton",
(!is.na(dem_ex_11) & dem_ex_11 %in% c("reid", "reed")) ~ "harry reid",
# Add more conditions as needed
TRUE ~ as.character(dem_ex_1)
),
dem_ex_2 = tolower(dem_ex_2),
demX2 = case_when(
(!is.na(dem_ex_21) & dem_ex_21 %in% c("obama", "oboma")) ~ "barack obama",
(!is.na(dem_ex_2) & dem_ex_2 %in% c("hillary clinton", "hilary clinton", "clinton")) ~ "hillary clinton",
(!is.na(dem_ex_21) & dem_ex_21 %in% c("reid", "reed")) ~ "harry reid",
# Add more conditions as needed
TRUE ~ as.character(dem_ex_2)
),
dem_ex_3 = tolower(dem_ex_3),
demX3 = case_when(
(!is.na(dem_ex_31) & dem_ex_31 %in% c("obama", "oboma")) ~ "barack obama",
(!is.na(dem_ex_3) & dem_ex_3 %in% c("hillary clinton", "hilary clinton", "clinton")) ~ "hillary clinton",
(!is.na(dem_ex_31) & dem_ex_31 %in% c("reid", "reed")) ~ "harry reid",
# Add more conditions as needed
TRUE ~ as.character(dem_ex_3)
)
)
