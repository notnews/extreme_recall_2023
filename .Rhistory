dem_ex_1 = tolower(dem_ex_1),
demX1 = case_when(
grepl("obama|oboma", dem_ex_11) | grepl("obama|oboma", dem_ex_12) | grepl("obama|oboma", dem_ex_13) ~ "barack obama",
grepl("hillary clinton|hilary clinton", dem_ex_1) | substr(dem_ex_11, 1, 1) == "h" & dem_ex_12 == "clinton" | substr(dem_ex_11, 1, 1) == "h" & substr(dem_ex_12, 1, 2) == "cl" ~ "hillary clinton",
grepl("bill clinton|clinton", dem_ex_1) ~ "bill clinton",
grepl("nancy pelosi", dem_ex_1) | grepl("pelosi", dem_ex_11) | grepl("pelosi", dem_ex_12) | grepl("pelosi", dem_ex_13) ~ "nancy pelosi",
grepl("reid|reed", dem_ex_11) | grepl("reid|reed", dem_ex_12) | grepl("reid|reed", dem_ex_13) ~ "harry reid",
grepl("jfk|john f. kennedy|john kennedy", dem_ex_1) ~ "jfk",
grepl("baucus", dem_ex_11) | grepl("baucus", dem_ex_12) | grepl("baucus", dem_ex_13) ~ "max baucus",
grepl("biden", dem_ex_11) | grepl("biden", dem_ex_12) | grepl("biden", dem_ex_13) ~ "joe biden",
grepl("gore", dem_ex_11) | grepl("gore", dem_ex_12) | grepl("gore", dem_ex_13) ~ "al gore",
grepl("carter", dem_ex_11) | grepl("carter", dem_ex_12) | grepl("carter", dem_ex_13) ~ "jimmy carter",
TRUE ~ ""
)
)
names(data)
