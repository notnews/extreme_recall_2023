# Load lib.
library(dplyr)
# Load dat
data <- read.csv("../data/turk/PartyExemplarsRecode.csv")
# Load lib.
library(dplyr)
# Load dat
data <- read.csv("data/turk/PartyExemplarsRecode.csv")
# Democrats
data <- data %>%
group_by(dem_ex_1) %>%
mutate(ctd1 = n()) %>%
group_by(dem_ex_2) %>%
mutate(ctd2 = n()) %>%
group_by(dem_ex_3) %>%
mutate(ctd3 = n()) %>%
mutate(
dem_ex_1 = tolower(dem_ex_1),
demX1 = case_when(
dem_ex_11 %in% c("obama", "oboma") ~ "barack obama",
dem_ex_1 %in% c("hillary clinton", "hilary clinton") |
(substr(dem_ex_11, 1, 1) == "h" & dem_ex_12 == "clinton") |
(substr(dem_ex_11, 1, 1) == "h" & substr(dem_ex_12, 1, 2) == "cl") ~ "hillary clinton",
dem_ex_1 %in% c("bill clinton", "clinton") ~ "bill clinton",
dem_ex_1 == "nancy pelosi" | dem_ex_11 == "pelosi" | dem_ex_12 == "pelosi" | dem_ex_13 == "pelosi" ~ "nancy pelosi",
dem_ex_11 %in% c("reid", "reed") | dem_ex_12 %in% c("reid", "reed") | dem_ex_13 %in% c("reid", "reed") ~ "harry reid",
dem_ex_1 %in% c("jfk", "john f. kennedy", "john kennedy") ~ "jfk",
dem_ex_11 == "baucus" | dem_ex_12 == "baucus" | dem_ex_13 == "baucus" ~ "max baucus",
dem_ex_11 == "biden" | dem_ex_12 == "biden" | dem_ex_13 == "biden" ~ "joe biden",
dem_ex_11 == "gore" | dem_ex_12 == "gore" | dem_ex_13 == "gore" ~ "al gore",
dem_ex_11 == "carter" | dem_ex_12 == "carter" | dem_ex_13 == "carter" ~ "jimmy carter"
),
dem_ex_2 = tolower(dem_ex_2),
demX2 = case_when(
dem_ex_21 %in% c("obama", "oboma") ~ "barack obama",
dem_ex_2 %in% c("hillary clinton", "hilary clinton") |
(substr(dem_ex_21, 1, 1) == "h" & dem_ex_22 == "clinton") |
(substr(dem_ex_21, 1, 1) == "h" & substr(dem_ex_22, 1, 2) == "cl") ~ "hillary clinton",
dem_ex_2 %in% c("bill clinton", "clinton") ~ "bill clinton",
dem_ex_2 == "nancy pelosi" | dem_ex_21 == "pelosi" | dem_ex_22 == "pelosi" | dem_ex_23 == "pelosi" ~ "nancy pelosi",
dem_ex_21 %in% c("reid", "reed") | dem_ex_22 %in% c("reid", "reed") | dem_ex_23 %in% c("reid", "reed") ~ "harry reid",
dem_ex_2 %in% c("jfk", "john f. kennedy", "john kennedy") ~ "jfk",
dem_ex_21 == "baucus" | dem_ex_22 == "baucus" | dem_ex_23 == "baucus" ~ "max baucus",
dem_ex_21 == "biden" | dem_ex_22 == "biden" | dem_ex_23 == "biden" ~ "joe biden",
dem_ex_21 == "gore" | dem_ex_22 == "gore" | dem_ex_23 == "gore" ~ "al gore",
dem_ex_21 == "carter" | dem_ex_22 == "carter" | dem_ex_23 == "carter" ~ "jimmy carter"
),
dem_ex_3 = tolower(dem_ex_3),
demX3 = case_when(
dem_ex_31 %in% c("obama", "oboma") ~ "barack obama",
dem_ex_3 %in% c("hillary clinton", "hilary clinton") |
(substr(dem_ex_31, 1, 1) == "h" & dem_ex_32 == "clinton") |
(substr(dem_ex_31, 1, 1) == "h" & substr(dem_ex_32, 1, 2) == "cl") ~ "hillary clinton",
dem_ex_3 %in% c("bill clinton", "clinton") ~ "bill clinton",
dem_ex_3 == "nancy pelosi" | dem_ex_31 == "pelosi" | dem_ex_32 == "pelosi" | dem_ex_33 == "pelosi" ~ "nancy pelosi",
dem_ex_31 %in% c("reid", "reed") | dem_ex_32 %in% c("reid", "reed") | dem_ex_33 %in% c("reid", "reed") ~ "harry reid",
dem_ex_3 %in% c("jfk", "john f. kennedy", "john kennedy") ~ "jfk",
dem_ex_31 == "baucus" | dem_ex_32 == "baucus" | dem_ex_33 == "baucus" ~ "max baucus",
dem_ex_31 == "biden" | dem_ex_32 == "biden" | dem_ex_33 == "biden" ~ "joe biden",
dem_ex_31 == "gore" | dem_ex_32 == "gore" | dem_ex_33 == "gore" ~ "al gore",
dem_ex_31 == "carter" | dem_ex_32 == "carter" | dem_ex_33 == "carter" ~ "jimmy carter"
)
)
