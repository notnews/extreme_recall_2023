data <- read.csv("C:/Users/dstone/Dropbox/who_how/data/survey_data/PartyExemplarsRecode.csv")
# Function to handle missing values in case_when
handle_missing <- function(x, replacements) {
ifelse(is.na(x) | x == "", "", replacements[[x]])
}
# Democrats
data <- data %>%
group_by(dem_ex_1) %>%
mutate(ctd1 = n()) %>%
group_by(dem_ex_2) %>%
mutate(ctd2 = n()) %>%
group_by(dem_ex_3) %>%
mutate(ctd3 = n()) %>%
mutate(
dem_ex_1 = tolower(dem_ex_1),
demX1 = handle_missing(dem_ex_11, list(
"barack obama" = c("obama", "oboma"),
"hillary clinton" = c("hillary clinton", "hilary clinton", "clinton"),
"harry reid" = c("reid", "reed")
# Add more replacements as needed
)),
dem_ex_2 = tolower(dem_ex_2),
demX2 = handle_missing(dem_ex_21, list(
"barack obama" = c("obama", "oboma"),
"hillary clinton" = c("hillary clinton", "hilary clinton", "clinton"),
"harry reid" = c("reid", "reed")
# Add more replacements as needed
)),
dem_ex_3 = tolower(dem_ex_3),
demX3 = handle_missing(dem_ex_31, list(
"barack obama" = c("obama", "oboma"),
"hillary clinton" = c("hillary clinton", "hilary clinton", "clinton"),
"harry reid" = c("reid", "reed")
# Add more replacements as needed
))
)
