require(quanteda)
require(quanteda.textmodels)
require(quanteda.textplots)
install.packages("quanteda.textmodels")
library(quanteda)
library(quanteda.textmodels)
library(quanteda.textplots)
toks_irish <- tokens(data_corpus_irishbudget2010,
remove_punct = TRUE)
toks_irish
dfmat_irish <- dfm(toks_irish)
summary(tmod_wf)
tmod_wf <- textmodel_wordfish(dfmat_irish, dir = c(6, 5))
summary(tmod_wf)
textplot_scale1d(tmod_wf)
textplot_scale1d(tmod_wf, groups = dfmat_irish$party)
textplot_scale1d(tmod_wf, margin = "features",
highlighted = c("government", "global", "children",
"bank", "economy", "the", "citizenship",
"productivity", "deficit"))
# let's fit a wordfish scaling model
tmod_wf <- textmodel_wordfish(dfmat_irish)
summary(tmod_wf)
textplot_scale1d(tmod_wf)
# let's fit a wordfish scaling model
tmod_wf <- textmodel_wordfish(dfmat_irish, dir = c(6, 5))
dfmat_irish
# let's look at the outcome of the prediction
summary(tmod_wf)
textplot_scale1d(tmod_wf)
# We can even visualize point estimates on a scale BY GROUP
textplot_scale1d(tmod_wf, groups = dfmat_irish$party)
# We can even visualize point estimates on a scale BY GROUP
# given that the group is in the corpus
textplot_scale1d(tmod_wf, groups = dfmat_irish$party)
textplot_scale1d(tmod_wf, margin = "features",
highlighted = c("government", "global", "children",
"bank", "economy", "the", "citizenship",
"productivity", "deficit"))
